# Cloud (default): Pollinations images + Edge TTS.
# Local: pip install -e ".[local]" then python -m script_to_shorts --download-models
# TTS_PROVIDER=edge
# IMAGE_PROVIDER=pollinations
# IMAGE_MODEL=stabilityai/sdxl-turbo
# LOCAL_VOICE=en_US-lessac-medium
# FASTVIDEO_DIR=../FastVideo
# FASTVIDEO_PYTHON=../FastVideo/.venv/bin/python
# FASTMETAL_MODEL_DIR=../FastVideo/FastMetal-1.3B-QAD
# FASTMETAL_5B_MODEL_DIR=../FastVideo/FastMetal-5B-QAD
# FASTMETAL_14B_MODEL_DIR=../FastVideo/FastMetal-14B-QAD
# MLX_WAN_DIR=../mlx-examples/video/wan2.1
# MLX_PYTHON=.venv/bin/python
# MLX_MODEL=fastmetal-1.3B-QAD
# MLX_SIZE=480x832
# MLX_STEPS=30
# Optional alternative to `hf auth login`; put the real token in .env only.
# HF_TOKEN=hf_your_read_token_here
VOICE=en-US-JennyNeural
WIDTH=1080
HEIGHT=1920
FPS=30
