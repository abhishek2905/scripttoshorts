{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Render sample short",
      "type": "debugpy",
      "request": "launch",
      "module": "script_to_shorts",
      "args": [
        "examples/sample_script.txt",
        "--out",
        "output/ep01.mp4"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Render current script",
      "type": "debugpy",
      "request": "launch",
      "module": "script_to_shorts",
      "args": [
        "${file}",
        "--out",
        "output/${fileBasenameNoExtension}.mp4"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "console": "integratedTerminal"
    }
  ]
}
